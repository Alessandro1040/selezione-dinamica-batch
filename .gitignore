# Artefatti di build LaTeX
tesi/*.aux
tesi/*.log
tesi/*.fls
tesi/*.out
tesi/*.toc
tesi/*.listing
tesi/*.fdb_latexmk
tesi/_minted/
tesi/_minted-*/
tesi/*.bak
tesi/figtest.*
tesi/frontespizio.pdf

# Python
__pycache__/
*.pyc

# Artefatti di build del documento teorema_convergenza_aspettativa
teorema_convergenza_aspettativa/*.aux
teorema_convergenza_aspettativa/*.log
teorema_convergenza_aspettativa/*.fls
teorema_convergenza_aspettativa/*.out
teorema_convergenza_aspettativa/*.fdb_latexmk

# Artefatti di build della presentazione
presentazione/*.aux
presentazione/*.log
presentazione/*.out
presentazione/*.nav
presentazione/*.snm
presentazione/*.toc
presentazione/*.vrb
presentazione/*.fls
presentazione/*.fdb_latexmk

# Artefatti di build degli schemi (i sorgenti .tex sono tracciati;
# le copie PDF ufficiali stanno in presentazione/immagini/)
presentazione/schemi/*.aux
presentazione/schemi/*.log
presentazione/schemi/*.out
presentazione/schemi/*.fls
presentazione/schemi/*.fdb_latexmk
presentazione/schemi/*.pdf
